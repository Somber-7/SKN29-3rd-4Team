# =============================================
# 사용법
# 1. 이 파일을 복사해서 .env 로 저장하세요.
# 2. .env 파일에서 your_xxx_here 부분을 실제 값으로 교체하세요.
# 3. .env 는 git에 커밋하지 마세요. (.gitignore에 등록되어 있음)
# =============================================

# =============================================
# 외부 API 키
# =============================================

# 국가법령정보 Open API (law_server.py)
# 발급: https://open.law.go.kr/LSO/main.do → 오픈API 신청
LAW_API_KEY=your_law_api_key_here

# 우리말샘 Open API (law_server.py)
# 발급: https://opendict.korean.go.kr/service/openApiInfo
URIMALSAM_API_KEY=your_urimalsam_api_key_here

# =============================================
# DB 경로 (기본값 사용 시 설정 불필요)
# =============================================

# SQLite 한자 DB 경로 (기본: data/hanja.db)
# HANJA_DB_PATH=data/hanja.db

# ChromaDB 저장 경로 (기본: data/chroma)
# CHROMA_DIR=data/chroma

# =============================================
# Neo4j (그래프 DB)
# =============================================

# Neo4j 로컬 인스턴스 (기본 포트)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================
# OpenAI API
# =============================================

# Router + Generate 노드에 사용 (gpt-4o-mini)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================
# Ollama (sLLM 파인튜닝 비교 실험용)
# =============================================

# Ollama 서버 주소 (기본: localhost)
# OLLAMA_HOST=http://localhost:11434
